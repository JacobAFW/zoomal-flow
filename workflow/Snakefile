if DECLONALIZE:
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/structure/declonalization_comparison.tsv",
        f"{PATHS['outputs']}/introgression/declonalization_comparison.tsv",
        f"{PATHS['outputs']}/moi/declonalization_comparison.tsv",
        f"{PATHS['reports']}/figures/declonalization_comparison.png",
        f"{PATHS['reports']}/figures/declonalization_comparison.svg",
    ]
    if SELECTION_MODELS:
        FINAL_TARGETS += [
