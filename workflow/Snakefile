# --------------------------------------------------------------------------
# Default target — Stage 0–3 outputs (this increment adds Stage 3 core).
# Common targets run regardless of input_type; WGS-specific diagnostic
# figures are added only when input_type == "wgs". Role-driven summaries +
# plots in Stage 2 are wired only when their backing role is present.
# --------------------------------------------------------------------------
FINAL_TARGETS = [
    f"{PATHS['outputs']}/setup/vcf_samples.txt",
    f"{PATHS['outputs']}/setup/contig_map.tsv",
    f"{PATHS['outputs']}/setup/nuclear_contigs.txt",
    f"{PATHS['outputs']}/metadata/samples.tsv",
    # Shared QC seam output — see top of 01_qc.smk for the contract.
    f"{PATHS['outputs']}/qc/snps.qc.vcf.gz",
    # Shared MOI seam output — see top of 02_moi.smk for the contract.
    f"{PATHS['outputs']}/moi/fws_MOI.tsv",
    f"{PATHS['outputs']}/moi/exclude_high_moi.txt",
]
# Stage 3 core outputs — figures land in 3b. Built once per sample set:
# `full` is the backbone every later stage reads; `unique` is the
# de-clonalized comparison branch (docs/clonality.md).
for _ss in SAMPLE_SETS:
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/structure/{_ss}/cleaned.fam",
        # Records whether LD-pruning ran or was skipped for a small cohort.
        f"{PATHS['outputs']}/structure/{_ss}/ld_prune_status.txt",
        f"{PATHS['outputs']}/structure/{_ss}/admixture/cv_error.tsv",
        f"{PATHS['outputs']}/structure/{_ss}/best_k.txt",
        f"{PATHS['outputs']}/structure/{_ss}/admix_clusters.tsv",
        f"{PATHS['outputs']}/structure/{_ss}/Pk.eigenvec",
        f"{PATHS['outputs']}/structure/{_ss}/pca_variance.tsv",
        f"{PATHS['outputs']}/structure/{_ss}/Pk.dist",
        f"{PATHS['reports']}/figures/{_ss}/admixture_cv.png",
    ]
    # Optional GIS-join target — present only if metadata.gis is configured.
    if META.get("gis"):
        FINAL_TARGETS += [
            f"{PATHS['outputs']}/structure/{_ss}/admix_clusters_gis.tsv",
        ]

# Stage 3 figures (3b) — role-guarded, one set per sample set.
for _ss in SAMPLE_SETS:
    FINAL_TARGETS += [
        f"{PATHS['reports']}/figures/{_ss}/admixture_bars.png",
        f"{PATHS['reports']}/figures/{_ss}/admixture_bars.svg",
        f"{PATHS['reports']}/figures/{_ss}/pca.png",
        f"{PATHS['reports']}/figures/{_ss}/pca.svg",
        f"{PATHS['reports']}/figures/{_ss}/njt.png",
        f"{PATHS['reports']}/figures/{_ss}/njt.svg",
    ]
    if ROLES.get("country"):
        FINAL_TARGETS += [
            f"{PATHS['reports']}/figures/{_ss}/admixture_bars_by_country.png",
            f"{PATHS['reports']}/figures/{_ss}/admixture_bars_by_country.svg",
        ]
    if ROLES.get("geography"):
        FINAL_TARGETS += [
            f"{PATHS['reports']}/figures/{_ss}/admixture_bars_by_geography.png",
            f"{PATHS['reports']}/figures/{_ss}/admixture_bars_by_geography.svg",
            f"{PATHS['reports']}/figures/{_ss}/pca_by_geography.png",
            f"{PATHS['reports']}/figures/{_ss}/pca_by_geography.svg",
        ]
    if META.get("gis") and ROLES.get("geography") and ROLES.get("country"):
        FINAL_TARGETS += [
            f"{PATHS['reports']}/figures/{_ss}/admix_map.png",
            f"{PATHS['reports']}/figures/{_ss}/admix_map.svg",
