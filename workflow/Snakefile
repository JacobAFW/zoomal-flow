        f"{PATHS['reports']}/figures/{_ss}/introgression_shoulder.svg",
    ]
    if ROLES.get("geography"):
        FINAL_TARGETS += [
            f"{PATHS['outputs']}/introgression/{_ss}/introgression_by_geography.tsv",
        ]
    if INTRO_FOCAL:
        FINAL_TARGETS += [
            # The focal RESULT: per-window enrichment against a subgroup-scaled
            # permutation null with its own BH/FDR (spec §9.6).
            f"{PATHS['outputs']}/introgression/{_ss}/focal_{INTRO_FOCAL}_enriched_windows.tsv",
            f"{PATHS['outputs']}/introgression/{_ss}/focal_{INTRO_FOCAL}_window_tests.tsv",
            # Descriptive only — the "unique windows" set difference carries no
            # significance test and is superseded by the two files above.
            f"{PATHS['outputs']}/introgression/{_ss}/unique_windows_in_{INTRO_FOCAL}_with_freq_and_coords.tsv",
