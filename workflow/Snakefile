# Stage 4 core targets. Per-cluster hmm_fract.txt files are expanded
# from the assign_clusters checkpoint at DAG-resolution time — see
# ibd_cluster_targets() in 04_ibd.smk. clonal_clusters.tsv aggregates
# every cluster's clonal pairs into a connected-component grouping;
# focal_<name>_clones.tsv is optional (ibd.focal_cluster).
FINAL_TARGETS += [
    f"{PATHS['outputs']}/ibd/clonal_clusters.tsv",
    f"{PATHS['outputs']}/ibd/combined/hmmIBD_input.tsv",
    ibd_cluster_targets,
]
if config["ibd"].get("focal_cluster"):
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/ibd/focal_{config['ibd']['focal_cluster']}_clones.tsv",
    ]

# Clonality: the de-clonalized keep-list + its audit. Derived AFTER Stage 4
# (clonality needs every sample) and never fed back into it.
if DECLONALIZE:
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/clonality/unique_genotypes.txt",
        f"{PATHS['outputs']}/clonality/declonalization_audit.tsv",
    ]

# Stage 4b figures. Connectivity is expanded via a checkpoint-aware input
# function; the temporal plot needs the date role. Both role-guarded.
if ROLES.get("geography"):
    FINAL_TARGETS += [ibd_connectivity_targets]
if ROLES.get("date"):
