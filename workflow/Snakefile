# Agnostic pop-gen pipeline — Snakefile
# --------------------------------------------------------------------------
# Invoke from the agnostic/ directory:
#
#   cd agnostic/
#   source ../envs/activate.sh        # V1 env (carried over; not duplicated)
#   snakemake --cores N
#
# Override the default config with --configfile path/to/cohort.yaml.
# Validates config before any rule is parsed; aborts with a clear error
# message if the config is malformed.
#
# Stages 0–4 core are implemented; later stages (Stage 4b figures, 5–6) are
# scheduled increments.
# --------------------------------------------------------------------------

import json
import sys
from pathlib import Path

# Make `scripts/py/` importable so we can call helpers at parse time.
_HERE = Path(workflow.basedir).resolve()              # workflow/
_AGNOSTIC = _HERE.parent                              # agnostic/
sys.path.insert(0, str(_AGNOSTIC / "scripts" / "py"))

from validate_config import load_and_validate         # noqa: E402
from contigs_from_fai import derive_contigs           # noqa: E402

# Default config + schema live under config/. Override config with --configfile.
DEFAULT_CONFIG = str(_AGNOSTIC / "config" / "config.yaml")
SCHEMA         = str(_AGNOSTIC / "config" / "schema" / "config.schema.yaml")

configfile: DEFAULT_CONFIG

# Validate up front — any required-key omission or bad input_type aborts the
# workflow before the DAG is built. Errors are printed to stderr by the helper.
load_and_validate(workflow.configfiles[-1] if workflow.configfiles else DEFAULT_CONFIG,
                  SCHEMA)

# Convenience accessors used across rules.
PATHS    = config["paths"]
COHORT   = config["cohort"]
REF      = config["reference"]
META     = config["metadata"]
ROLES    = META["roles"]
CONTROLS = config["controls"]
QC       = config["qc"]

# Derive the nuclear-contig list from the reference .fai at parse time.
# This replaces V1's hand-listed nuclear_contigs array. The contig→integer
# map (for later stages that need integer chrom codes) is written to disk
# by a dedicated rule (`build_contig_map`) so it travels with outputs/.
_FAI = REF["fasta"] + ".fai"
NUCLEAR_CONTIGS = derive_contigs(_FAI, REF.get("exclude_contigs", []))
if not NUCLEAR_CONTIGS:
    sys.exit(f"ERROR: no contigs left after applying exclude_contigs={REF.get('exclude_contigs', [])} "
             f"to {_FAI}. Check reference.exclude_contigs in your config.")

# Ensure top-level output dirs exist (cheap; avoids the first rule racing on mkdir).
for d in (PATHS["outputs"], PATHS["logs"], PATHS["reports"]):
    Path(d).mkdir(parents=True, exist_ok=True)

# Persist the role map to disk at parse time so the metadata-validator R
# script can read it as a plain file. Avoids embedding JSON literals (with
# curly braces) inside a Snakemake shell template, which would collide with
# Snakemake's own {placeholder} substitution.
ROLES_JSON = Path(PATHS["outputs"]) / "setup" / "roles.json"
ROLES_JSON.parent.mkdir(parents=True, exist_ok=True)
ROLES_JSON.write_text(json.dumps(ROLES, indent=2) + "\n")

# --------------------------------------------------------------------------
# Per-stage rules
# --------------------------------------------------------------------------
include: "rules/00_setup.smk"
include: "rules/01_qc.smk"
include: "rules/02_moi.smk"
include: "rules/03_structure.smk"
include: "rules/03_figures.smk"
include: "rules/04_ibd.smk"

# --------------------------------------------------------------------------
# Default target — Stage 0–3 outputs (this increment adds Stage 3 core).
# Common targets run regardless of input_type; WGS-specific diagnostic
# figures are added only when input_type == "wgs". Role-driven summaries +
# plots in Stage 2 are wired only when their backing role is present.
# --------------------------------------------------------------------------
FINAL_TARGETS = [
    f"{PATHS['outputs']}/setup/vcf_samples.txt",
    f"{PATHS['outputs']}/setup/contig_map.tsv",
    f"{PATHS['outputs']}/setup/nuclear_contigs.txt",
    f"{PATHS['outputs']}/metadata/samples.tsv",
    # Shared QC seam output — see top of 01_qc.smk for the contract.
    f"{PATHS['outputs']}/qc/snps.qc.vcf.gz",
    # Shared MOI seam output — see top of 02_moi.smk for the contract.
    f"{PATHS['outputs']}/moi/fws_MOI.tsv",
    f"{PATHS['outputs']}/moi/exclude_high_moi.txt",
    # Stage 3 core outputs — figures land in 3b.
    f"{PATHS['outputs']}/structure/cleaned.fam",
    f"{PATHS['outputs']}/structure/admixture/cv_error.tsv",
    f"{PATHS['outputs']}/structure/best_k.txt",
    f"{PATHS['outputs']}/structure/admix_clusters.tsv",
    f"{PATHS['outputs']}/structure/Pk.eigenvec",
    f"{PATHS['outputs']}/structure/pca_variance.tsv",
    f"{PATHS['outputs']}/structure/Pk.dist",
    f"{PATHS['reports']}/figures/admixture_cv.png",
]
# Optional GIS-join target — present only if metadata.gis is configured.
if META.get("gis"):
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/structure/admix_clusters_gis.tsv",
    ]

# Stage 3 figures (3b) — role-guarded.
# Always:
FINAL_TARGETS += [
    f"{PATHS['reports']}/figures/admixture_bars.png",
    f"{PATHS['reports']}/figures/admixture_bars.svg",
    f"{PATHS['reports']}/figures/pca.png",
    f"{PATHS['reports']}/figures/pca.svg",
    f"{PATHS['reports']}/figures/njt.png",
    f"{PATHS['reports']}/figures/njt.svg",
]
if ROLES.get("country"):
    FINAL_TARGETS += [
        f"{PATHS['reports']}/figures/admixture_bars_by_country.png",
        f"{PATHS['reports']}/figures/admixture_bars_by_country.svg",
    ]
if ROLES.get("geography"):
    FINAL_TARGETS += [
        f"{PATHS['reports']}/figures/admixture_bars_by_geography.png",
        f"{PATHS['reports']}/figures/admixture_bars_by_geography.svg",
        f"{PATHS['reports']}/figures/pca_by_geography.png",
        f"{PATHS['reports']}/figures/pca_by_geography.svg",
    ]
if META.get("gis") and ROLES.get("geography") and ROLES.get("country"):
    FINAL_TARGETS += [
        f"{PATHS['reports']}/figures/admix_map.png",
        f"{PATHS['reports']}/figures/admix_map.svg",
    ]

# Stage 4 core targets. Per-cluster hmm_fract.txt files are expanded
# from the assign_clusters checkpoint at DAG-resolution time — see
# ibd_cluster_targets() in 04_ibd.smk. clonal_clusters.tsv aggregates
# every cluster's clonal pairs into a connected-component grouping;
# focal_<name>_clones.tsv is optional (ibd.focal_cluster).
FINAL_TARGETS += [
    f"{PATHS['outputs']}/ibd/clonal_clusters.tsv",
    f"{PATHS['outputs']}/ibd/combined/hmmIBD_input.tsv",
    ibd_cluster_targets,
]
if config["ibd"].get("focal_cluster"):
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/ibd/focal_{config['ibd']['focal_cluster']}_clones.tsv",
    ]
if COHORT["input_type"] == "wgs":
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/qc/variant_count.txt",
        f"{PATHS['reports']}/figures/maf_density_overall.png",
        f"{PATHS['reports']}/figures/maf_density_by_chrom.png",
        f"{PATHS['reports']}/figures/miss_density_per_sample.png",
        f"{PATHS['reports']}/figures/miss_density_per_variant.png",
    ]

# Role-driven Stage 2 targets — added only when their role is configured.
if ROLES.get("country"):
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/moi/fws_by_country.tsv",
        f"{PATHS['reports']}/figures/fws_density_by_country.png",
        f"{PATHS['reports']}/figures/fws_density_by_country.svg",
    ]
if ROLES.get("geography"):
    FINAL_TARGETS += [
        f"{PATHS['outputs']}/moi/fws_by_geography.tsv",
        f"{PATHS['reports']}/figures/fws_density_by_geography.png",
        f"{PATHS['reports']}/figures/fws_density_by_geography.svg",
    ]

rule all:
    input:
        FINAL_TARGETS
