# Agnostic pop-gen pipeline — Snakefile
# --------------------------------------------------------------------------
# Invoke from the agnostic/ directory:
#
#   cd agnostic/
#   source ../envs/activate.sh        # V1 env (carried over; not duplicated)
#   snakemake --cores N
#
# Override the default config with --configfile path/to/cohort.yaml.
# Validates config before any rule is parsed; aborts with a clear error
# message if the config is malformed.
#
# Stages 0–4 core are implemented; later stages (Stage 4b figures, 5–6) are
# scheduled increments.
# --------------------------------------------------------------------------

import json
import sys
from pathlib import Path

# Make `scripts/py/` importable so we can call helpers at parse time.
_HERE = Path(workflow.basedir).resolve()              # workflow/
_AGNOSTIC = _HERE.parent                              # agnostic/
sys.path.insert(0, str(_AGNOSTIC / "scripts" / "py"))

from validate_config import load_and_validate         # noqa: E402
from contigs_from_fai import derive_contigs           # noqa: E402

# Default config + schema live under config/. Override config with --configfile.
DEFAULT_CONFIG = str(_AGNOSTIC / "config" / "config.yaml")
SCHEMA         = str(_AGNOSTIC / "config" / "schema" / "config.schema.yaml")

configfile: DEFAULT_CONFIG

# Which config file is the ACTIVE one?
#
# Snakemake orders `workflow.configfiles` as [--configfile entries..., entries
# from the `configfile:` directive], so the DEFAULT_CONFIG declared above is
# always LAST. Taking [-1] therefore validates the shipped template and never
# the user's cohort config — which meant that, since every documented
# invocation passes --configfile, schema validation was silently a no-op and an
# invalid cohort config surfaced later as a confusing FileNotFoundError instead
# of a clear schema error. Take the first entry that is not the default.
def _active_configfile():
    for c in workflow.configfiles:
        if str(Path(c).resolve()) != str(Path(DEFAULT_CONFIG).resolve()):
            return str(Path(c).resolve())
    return str(Path(DEFAULT_CONFIG).resolve())


ACTIVE_CONFIG = _active_configfile()

# Validate up front — any required-key omission or bad input_type aborts the
# workflow before the DAG is built. Errors are printed to stderr by the helper.
load_and_validate(ACTIVE_CONFIG, SCHEMA)

# Convenience accessors used across rules.
PATHS    = config["paths"]
COHORT   = config["cohort"]
REF      = config["reference"]
META     = config["metadata"]
ROLES    = META["roles"]
CONTROLS = config["controls"]
QC       = config["qc"]

# --------------------------------------------------------------------------
# The {sampleset} axis — clonality handling (docs/clonality.md)
# --------------------------------------------------------------------------
# Clonal samples are near-identical genotypes. Counting each as independent
# evidence is pseudo-replication and it biases every FREQUENCY- or COUNT-based
# analysis. So the four frequency stages (structure, introgression, group
# summaries, selection) are parameterised by a `{sampleset}` wildcard and BOTH
# arms are always produced side by side:
#
#   full   — every sample. The OPERATIONAL BACKBONE: Stage 4 clonal detection
#            and the Stage-5 introgression cluster definitions key off the
#            full-set clusters, and nothing here changes that.
#   unique — one representative per clonal group + every unclustered sample.
#            A reporting / comparison branch. It must NOT feed Stage 4 or the
#            Stage-5 cluster definitions; doing so would be circular.
#
# One pass, not iterated: the keep-list is derived once from the full-set
# clonal groups and used as-is. See docs/clonality.md for why.
CLONALITY   = config.get("clonality", {}) or {}
DECLONALIZE = bool(CLONALITY.get("declonalize", True))
SAMPLE_SETS = ["full"] + (["unique"] if DECLONALIZE else [])
if not DECLONALIZE:
    sys.stderr.write(
        "[clonality] clonality.declonalize is false — only the 'full' sample set "
        "will be built; no de-clonalized comparison outputs\n"
    )


wildcard_constraints:
    # Keeps `{sampleset}` from swallowing path separators or matching a
    # cluster / model name that happens to sit at the same depth.
    sampleset = r"full|unique",


CLONALITY_DIR = f"{PATHS['outputs']}/clonality"


def sampleset_exclude(sampleset):
    """
    Path of the sample-EXCLUSION list defining one sample set.

    A drop-list, not a keep-list, and that is deliberate. The stages have
    DIFFERENT natural sample universes — Stage 2 scores Fws for every sample
    that survived QC (978 on the Indo cohort), Stage 3 works on the PLINK set
    (807), Stage 5 on the clustered set (553). A keep-list intersected against
    each of those would silently shrink the `full` arm to whichever universe
    the list was drawn from, and `full` would stop reproducing the
    pre-clonality pipeline. "Remove these specific samples" is a no-op for
    `full` in every stage regardless of universe, so:

        exclude_full.txt    empty        -> full is bit-identical to before
        exclude_unique.txt  the non-representative members of each clonal group

    The human-facing keep-lists (all_genotypes.txt / unique_genotypes.txt) are
    written too — they are what you read to see what the sample sets ARE — but
    the rules wire the drop-list, because that is what is safe.
    """
    return f"{CLONALITY_DIR}/exclude_{sampleset}.txt"


# Derive the nuclear-contig list from the reference .fai at parse time.
# This replaces V1's hand-listed nuclear_contigs array. The contig→integer
# map (for later stages that need integer chrom codes) is written to disk
# by a dedicated rule (`build_contig_map`) so it travels with outputs/.
_FAI = REF["fasta"] + ".fai"
NUCLEAR_CONTIGS = derive_contigs(_FAI, REF.get("exclude_contigs", []))
if not NUCLEAR_CONTIGS:
    sys.exit(f"ERROR: no contigs left after applying exclude_contigs={REF.get('exclude_contigs', [])} "
             f"to {_FAI}. Check reference.exclude_contigs in your config.")

# Ensure top-level output dirs exist (cheap; avoids the first rule racing on mkdir).
for d in (PATHS["outputs"], PATHS["logs"], PATHS["reports"]):
    Path(d).mkdir(parents=True, exist_ok=True)

# Persist the role map to disk at parse time so the metadata-validator R
# script can read it as a plain file. Avoids embedding JSON literals (with
# curly braces) inside a Snakemake shell template, which would collide with
# Snakemake's own {placeholder} substitution.
ROLES_JSON = Path(PATHS["outputs"]) / "setup" / "roles.json"
ROLES_JSON.parent.mkdir(parents=True, exist_ok=True)
ROLES_JSON.write_text(json.dumps(ROLES, indent=2) + "\n")


